{
  "name": "hardened_mcp_gateway",
  "version": "1.1.0",
  "description": "Intent-bound authorization (semantic firewall) for MCP tool calls: reference implementation and evaluation",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:proxy": "node src/index.js proxy",
    "start:protected": "node src/index.js protected",
    "start:inspector": "node src/index.js inspector",
    "start:orchestrator": "node src/index.js orchestrator",
    "demo:allow": "node src/demo/client.js allow",
    "demo:block": "node src/demo/client.js block",
    "demo:approve": "node src/demo/client.js approve",
    "demo:guided": "node src/demo/guided-attack.js",
    "presenter": "node src/demo/presenter-mode.js",
    "test": "vitest run",
    "experiment:e1": "node experiments/run-enforcement.js",
    "experiment:e1:no-model": "node experiments/run-enforcement.js --configs C0,C1,C2,C3",
    "experiment:e2": "node experiments/run-protocol-attacks.js --target fixed --root .",
    "experiment:e3": "node experiments/run-summarizer.js",
    "analyze": "node experiments/analyze.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "better-sqlite3": "^12.8.0",
    "fastify": "^5.8.4",
    "jsonwebtoken": "^9.0.3",
    "undici": "^7.24.6"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
